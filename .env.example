# Generate every secret independently, for example with:
#   openssl rand -base64 48
APP_ENV=prod
DEBUG=0
SESSION_SIGNING_KEY=
SIGNUP_TOKEN_KEY=
PUBLIC_LINK_HMAC_KEY=
DATA_ENCRYPTION_KEY=
INTERNAL_JOB_TOKEN=
SETUP_TOKEN=

# Auth / sessions
# - In production (APP_ENV=prod) auth is required by default.
# - In development you can turn it on explicitly:
#     AUTH_REQUIRED=1
AUTH_REQUIRED=1
CSRF_ENABLED=1

# Public self-service signup for regular customer accounts.
# - In development it is enabled by default.
# - In production it is disabled by default; set SIGNUP_ENABLED=1 to open /signup.
#SIGNUP_ENABLED=1

# /setup is available only when SETUP_TOKEN is configured and the database
# contains no users. Remove SETUP_TOKEN after the first account is created.

# Database
# When running the app on your host machine (MariaDB/MySQL locally or docker compose published port):
#   mysql+pymysql://fakturek:fakturek@127.0.0.1:3306/fakturek?charset=utf8mb4
# When running the app in the same docker network:
#   mysql+pymysql://fakturek:fakturek@db:3306/fakturek?charset=utf8mb4
# Optional: unix socket (Debian default):
#   mysql+pymysql://fakturek:fakturek@localhost/fakturek?unix_socket=/run/mysqld/mysqld.sock&charset=utf8mb4
DATABASE_URL=mysql+pymysql://fakturek:fakturek@db:3306/fakturek?charset=utf8mb4
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=fakturek
MARIADB_USER=fakturek
MARIADB_PASSWORD=
APP_PORT=8000

# Optional deployment extension. Leave empty for the standalone application.
#FAKTUREK_EXTENSION_MODULE=example_fakturek_extension

# Company lookup (CZ: ARES)
#
# Used for the "Načíst z ARES" helper on the contact form.
# Default should work out of the box.
ARES_BASE_URL=https://ares.gov.cz/ekonomicke-subjekty-v-be/rest/ekonomicke-subjekty
# Network timeout (seconds)
ARES_TIMEOUT_SECONDS=5
# Cache TTL (days) for `company_lookup_cache`
COMPANY_LOOKUP_CACHE_TTL_DAYS=30

# Company lookup (SK: RPO + ORSR fallback)
#
# Used for the "Načíst z RPO (SK)" helper on the contact form.
# Default should work out of the box for RPO.
SK_RPO_BASE_URL=https://api.statistics.sk/rpo/v1
SK_RPO_TIMEOUT_SECONDS=5
# ORSR is used only as a fallback if RPO does not return any result.
SK_ORSR_BASE_URL=https://www.orsr.sk
SK_ORSR_TIMEOUT_SECONDS=5

# PDF storage (phase-20)
#
# Directory where *issued* invoice PDFs are persisted. It should be outside any
# web-served directory ("webroot"). If relative, it's resolved against the
# project root.
PDF_STORAGE_DIR=var/pdfs

# Public invoice (phase-21)
#
# If your app runs behind a reverse proxy / platform router, set this to the
# externally visible URL so public invoice links never contain an internal port.
# Example:
#   PUBLIC_BASE_URL=https://app.example.com
PUBLIC_BASE_URL=https://invoices.example.com
APP_BASE_URL=https://invoices.example.com
TRUSTED_PROXY_IPS=127.0.0.1,::1
#
# Basic in-memory rate limit for public invoice endpoints.
# Values are per-process (each worker has its own limiter).
PUBLIC_RATE_LIMIT_MAX=120
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60

# SMTP email (phase-22)
#
# Configure this if you want to send invoices by email from the invoice detail.
#
# Minimal:
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_USERNAME=...
#   SMTP_PASSWORD=...
#   SMTP_USE_STARTTLS=1
#
# For implicit TLS (SMTPS, typically port 465):
#   SMTP_USE_TLS=1
#   SMTP_USE_STARTTLS=0

#SMTP_HOST=
SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
SMTP_USE_TLS=0
SMTP_USE_STARTTLS=1
SMTP_TIMEOUT_SECONDS=10

# Optional override for the From header.
# If not set, Fakturek will prefer the current Subject email (Settings → Subject) and
# then fall back to ISSUER_EMAIL.
#SMTP_FROM_EMAIL=
#SMTP_FROM_NAME=

# Import (phase-24)
#
# Directory where uploaded import files are stored. Keep it outside any web-served
# directory. If relative, it's resolved against the project root.
#
IMPORT_STORAGE_DIR=var/imports

# Max upload size for import files (MB).
IMPORT_MAX_UPLOAD_MB=25
